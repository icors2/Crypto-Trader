# Copy to .env for local stdio MCP and the bot (never commit .env).
# Use the same names in Cursor Cloud Secrets and in .cursor/mcp.json as ${env:NAME}.
# Names only — do not assign values in this file.

# Docs
# CONTEXT7_API_KEY

# Hard ceilings the settings form cannot exceed
# MAX_NOTIONAL_USD
# MAX_DAILY_LOSS_USD
# MAX_WEEKLY_LOSS_USD
# MAX_CUMULATIVE_LOSS_USD
# MIN_POLL_INTERVAL_SEC
# MAX_OPEN_POSITIONS

# Web UI
# UI_PASSWORD_HASH
# UI_PASSWORD
# UI_SESSION_SECRET
# SECURE_COOKIES
# BIND_HOST
# PORT

# Paths
# DATA_DIR
# CONFIG_DIR

# Robinhood Crypto API v2 (official; required for live)
# ROBINHOOD_API_KEY
# ROBINHOOD_PRIVATE_KEY
# ROBINHOOD_ACCOUNT_NUMBER

# Alerts (ntfy)
# NTFY_TOPIC
# NTFY_URL
